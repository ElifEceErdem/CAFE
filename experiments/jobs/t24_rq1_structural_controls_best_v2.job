#!/bin/bash
#SBATCH --job-name=t24_rq1_best_v2
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=24:00:00
#SBATCH --array=0-4%5
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t24_rq1_best_v2_%A_%a.out

# CPU-only conditional-hit and alternative-axis analysis of the recommendation
# artifacts generated by t23_rq1_best_configs_upstream.job.  This v2 wrapper
# leaves coefficients and CIs unchanged, but requires optimizer success plus a
# per-observation analytic-score tolerance instead of applying 1e-4 to a score
# summed over a dataset-dependent number of observations.

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

REPO=/home/eerdem/workspace/CAFE
DATA=${REPO}/data/SNAP
DEFAULT_UPSTREAM=${REPO}/results_rq1_controls/structural_best_configs_nonedgewise_upstream_v1
UPSTREAM=${RQ1_BEST_CONTROLS_UPSTREAM:-${DEFAULT_UPSTREAM}}
CAMPAIGN=${RQ1_BEST_CONTROLS_CAMPAIGN:-${REPO}/results_rq1_controls/structural_best_configs_nonedgewise_v2}

TASK_ID=${SLURM_ARRAY_TASK_ID:?submit this file as a Slurm array}
if (( TASK_ID < 0 || TASK_ID > 4 )); then
    echo "ERROR: array task must be in 0..4" >&2
    exit 2
fi
DATASETS=(ego-facebook oklahoma unc pokec_n brightkite)
DATASET=${DATASETS[TASK_ID]}
OUTPUT_DIR=${CAMPAIGN}/shards/${DATASET}

# The adapter is hash-bound to analysis/best_configs.csv and historical mean
# reduction.  Refuse to analyze a silently changed adapter.
cd "${REPO}"
python -u experiments/configs/verify_legacy_best_configs.py

for SEED in 42 43 44; do
    SHARD=${UPSTREAM}/stratified/${DATASET}/seed_${SEED}
    [[ -f "${SHARD}/_SUCCESS" ]] || {
        echo "ERROR: complete best-config upstream shard absent: ${SHARD}" >&2
        echo "Run t23_rq1_best_configs_upstream.job first." >&2
        exit 2
    }
done
mkdir -p "${OUTPUT_DIR}"

export MPLCONFIGDIR=/tmp/cafe-rq1-best-v2-mpl-${SLURM_JOB_ID}-${TASK_ID}
export XDG_CACHE_HOME=/tmp/cafe-rq1-best-v2-cache-${SLURM_JOB_ID}-${TASK_ID}
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK}
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

printf '%q ' python -u analysis/rq1_structural_controls_best_v2.py run \
    --dataset "${DATASET}" \
    --data-path "${DATA}" \
    --upstream-root "${UPSTREAM}" \
    --output-dir "${OUTPUT_DIR}" \
    --threads "${SLURM_CPUS_PER_TASK}" > "${OUTPUT_DIR}/command.sh"
printf '\n' >> "${OUTPUT_DIR}/command.sh"
{
    printf 'profile=%s\n' rq1_conditional_hit_and_clustering_axis_best_configs_v2
    printf 'upstream=%s\n' "${UPSTREAM}"
    printf 'campaign=%s\n' "${CAMPAIGN}"
    printf 'dataset=%s\n' "${DATASET}"
    printf 'score_tolerance_per_observation=%s\n' 1e-7
} > "${OUTPUT_DIR}/task.env"
conda list --explicit | sed '/^[[:space:]]*$/d' \
    > "${OUTPUT_DIR}/runtime.conda-explicit.txt"

python -u analysis/rq1_structural_controls_best_v2.py run \
    --dataset "${DATASET}" \
    --data-path "${DATA}" \
    --upstream-root "${UPSTREAM}" \
    --output-dir "${OUTPUT_DIR}" \
    --threads "${SLURM_CPUS_PER_TASK}" \
    2>&1 | tee "${OUTPUT_DIR}/runner.log"

python -u analysis/rq1_structural_controls_best_v2.py finalize \
    --campaign-dir "${CAMPAIGN}" --if-complete

echo "Best-config RQ1 structural-control v2 task complete: ${DATASET}"
