#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48GB
#SBATCH --time=12:00:00
#SBATCH --array=0-1
#SBATCH --job-name=cl_v1_gate
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/closeness_v1_gate_%A_%a.out
set -euo pipefail
: "${CLOSENESS_V1_ROOT:?Provide prepared campaign root}"
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export CUDA_VISIBLE_DEVICES=""
V1_CACHE=$(mktemp -d /tmp/cafe-cl-v1-gate.XXXXXX)
export MPLCONFIGDIR=${V1_CACHE}
cd /home/eerdem/workspace/CAFE
/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python -u experiments/reevaluate_closeness_v1.py \
    --output-root "${CLOSENESS_V1_ROOT}" --group gate --index "${SLURM_ARRAY_TASK_ID}"
