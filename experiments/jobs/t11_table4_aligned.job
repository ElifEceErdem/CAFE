#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=48GB
#SBATCH --time=166:00:00
#SBATCH --array=0-19
#SBATCH --job-name=t11_t04_aligned
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t11_table4_aligned_%A_%a.out

# Tasks 0..4 ego-facebook; 5..9 UNC; 10..14 Pokec-n; 15..19 Brightkite.
# Within each block: RA, HL-GNN, Fusion, CAFE-In, CAFE-Pre. No Oklahoma.
set -euo pipefail
REPO=/home/eerdem/workspace/CAFE
PYTHON_BIN=/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python
: "${ALIGNED_ROOT:?Set ALIGNED_ROOT to a prepared isolated directory}"
export LD_LIBRARY_PATH=/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}
export PYTHONDONTWRITEBYTECODE=1
TASK_CACHE=$(mktemp -d /tmp/cafe-t11-aligned.XXXXXX)
export MPLCONFIGDIR=${TASK_CACHE}
cd "${REPO}"
"${PYTHON_BIN}" -c 'import torch; assert torch.cuda.is_available(), "No SLURM GPU; refusing CPU fallback"'
"${PYTHON_BIN}" -u experiments/replay_table11_aligned.py \
    --output-root "${ALIGNED_ROOT}" --task-index "${SLURM_ARRAY_TASK_ID}"
