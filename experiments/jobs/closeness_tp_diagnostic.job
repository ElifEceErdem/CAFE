#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48GB
#SBATCH --time=48:00:00
#SBATCH --array=0-1
#SBATCH --job-name=cl_tp_metric_diag
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/closeness_tp_diagnostic_%A_%a.out

# CPU only. Replays deterministic heuristics in original order, not GNN training.
# Their order preserves random-fill state. Only RA recommendations are probed.
# No predictions, node-level centralities, or checkpoints are saved.
set -euo pipefail
REPO=/home/eerdem/workspace/CAFE
PYTHON_BIN=/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python
DATASETS=(brightkite pokec_n)
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export CUDA_VISIBLE_DEVICES=""
DIAGNOSTIC_CACHE=$(mktemp -d /tmp/cafe-closeness-diagnostic.XXXXXX)
export MPLCONFIGDIR=${DIAGNOSTIC_CACHE}
cd "${REPO}"
"${PYTHON_BIN}" -u analysis/diagnose_closeness_tp.py \
    --dataset "${DATASETS[SLURM_ARRAY_TASK_ID]}" --replay-ra \
    --output-root "${REPO}/comparison_tables/closeness_tp_diagnostic_20260907"
