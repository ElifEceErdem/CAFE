#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=08:00:00
#SBATCH --job-name=cafe_pre_diag
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/cafe_pre_diagnostic_%j.out

# Four fresh one-run processes (off/on/off/on) share this single GPU allocation.
set -euo pipefail
REPO=/home/eerdem/workspace/CAFE
PYTHON_BIN=/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python
: "${DIAGNOSTIC_ROOT:?Set DIAGNOSTIC_ROOT to the prepared isolated directory}"
export LD_LIBRARY_PATH=/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}
export PYTHONDONTWRITEBYTECODE=1
TASK_CACHE=$(mktemp -d /tmp/cafe-pre-diagnostic.XXXXXX)
export MPLCONFIGDIR=${TASK_CACHE}
cd "${REPO}"
"${PYTHON_BIN}" -u experiments/diagnose_cafe_pre.py --output-root "${DIAGNOSTIC_ROOT}"
