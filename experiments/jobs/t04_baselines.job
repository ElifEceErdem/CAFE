#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=48GB
#SBATCH --time=160:00:00
#SBATCH --array=0-4
#SBATCH --job-name=t04_base
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t04_baselines_%A_%a.out

# Table 4 -- every non-CAFE row: heuristics (random/PA/CN/AA/RA), LightGCN,
# SSNet, Cross-Link Bias, LTLP, TailSTEAK, plus FairAdj / LBA / MORAL on the
# attribute datasets (Table 8).
#
# run_baselines.py takes neither --predictor/--lr/--patience/--eval_steps nor
# the fast-eval flags, and --results_dir is the TREE ROOT, not a per-dataset
# directory. Trained baselines run 300 epochs; each keeps its own default lr
# (MORAL pinned to 3e-4 inside the registry).
#
# FairAdj and LBA build N x N identity features, so pokec_n needs a
# large-memory GPU:
#   sbatch --constraint=TitanRTX --array=3 t04_baselines.job

# NOTE: under Slurm $0 is a copy of this script in the spool directory, so
# dirname "$0" does NOT point at experiments/jobs. Source by absolute path and
# fail loudly -- set -e lives inside _common.sh, so a silent miss here would
# leave every variable unset and run the python calls from the wrong cwd.
REPO=/home/eerdem/workspace/CAFE
COMMON_SH=${REPO}/experiments/jobs/_common.sh
if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
source "${COMMON_SH}"
cd ${REPO}/experiments

METHODS="random,pa,cn,aa,ra,lightgcn,ssnet,cross_link_bias,ltlp,tailsteak"
if [ "${DS}" = "oklahoma" ] || [ "${DS}" = "unc" ] || [ "${DS}" = "pokec_n" ]; then
  METHODS="${METHODS},fairadj,lba,moral"
fi

mkdir -p ${RESULTS_ROOT}/${DS}

python -u run_baselines.py \
    --data_name ${DS} --data_path ${DATA} \
    --encoder HLGNN \
    --methods "${METHODS}" \
    --runs 10 --seed 42 \
    --epochs 300 --batch_size 16384 \
    --use_equality_gain True --use_centrality_gain True \
    --centrality_types pagerank,closeness \
    --results_dir ${RESULTS_ROOT} ${SPLIT}

echo "Done."
