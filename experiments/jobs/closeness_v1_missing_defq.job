#!/bin/bash
#SBATCH --partition=defq
#SBATCH --exclude=node203
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=48GB
#SBATCH --time=166:00:00
#SBATCH --job-name=t07_exact_defq
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/closeness_v1_defq_%A_%a.out
# User restriction, 2026-09-13: node203 is NOT authorized, even if idle.
# Keep the original hash-frozen launch script unchanged for active tasks.
set -euo pipefail
if [[ "${SLURMD_NODENAME:-}" == "node203" || "${SLURM_JOB_PARTITION:-}" != "defq" ]]; then
    echo "FATAL: this campaign is restricted to defq and must never use node203" >&2
    exit 1
fi
exec bash /home/eerdem/workspace/CAFE/experiments/jobs/closeness_v1_missing.job
