#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16GB
#SBATCH --time=04:00:00
#SBATCH --job-name=build_tables
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/build_tables_%A.out

# Final CPU aggregation: verify every table's sources, then build them.
#
# The verify pass is the point of this suite. It refuses any table whose
# result JSONs lack eg_graph_semantics = simple_undirected_set_union, i.e.
# whose Degree/PageRank EG columns came from the metric superseded on
# 2026-07-23. Build still runs afterwards so the output can be inspected, but
# read the verify report before pasting anything.

source ~/.bashrc
conda activate hl_gnn
set -uo pipefail

REPO=/home/eerdem/workspace/CAFE
cd ${REPO}

echo "############## CONFIG CROSS-CHECK ##############"
python -m experiments.tables --stage configs

echo ""
echo "############## VERIFY ##############"
python -m experiments.tables --stage verify --tables all
VERIFY_RC=$?

echo ""
echo "############## BUILD ##############"
python -m experiments.tables --stage build --tables all
python -m experiments.tables.figures --stage build

echo ""
if [ ${VERIFY_RC} -ne 0 ]; then
  echo "VERIFY FAILED -- at least one table's EG columns are not on the"
  echo "Section 3.3 metric, or a source is missing. See the report above."
else
  echo "All tables verified and built."
fi
ls -la ${REPO}/results_repro/tables
