#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=166:00:00
#SBATCH --array=0-4
#SBATCH --job-name=t15_pair
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t15_paired_validation_%A_%a.out

# Isolated validation rerun for paper Table 15 (historical code name: t16).
# Array index -> dataset:
#   0=ego-facebook 1=oklahoma 2=unc 3=pokec_n 4=brightkite
#
# Protocol:
#   - seeds 0..9;
#   - a fresh train/validation/test split per seed for the four random-split
#     datasets;
#   - the fixed proxy-temporal split for Brightkite;
#   - every method within a seed shares the same split.
#
# Metric semantics in the current, deliberately unchanged scientific code:
#   - Degree EG: certified legacy directed-indegree definition;
#   - PageRank/Closeness EG: simple-undirected set-union graphs.
# run_significance.py currently writes the coarse historical marker
# "simple_undirected_set_union" into eg_graph_semantics for every metric.
# For this campaign, this job file and its source_manifest_sha256 are the
# authoritative granular semantics record.

REPO=/home/eerdem/workspace/CAFE
RESULTS_ROOT=${RESULTS_ROOT:-${REPO}/results/validation/20260902_table15_rerun}
export RESULTS_ROOT

COMMON_SH=${REPO}/experiments/jobs/_common.sh
SELECTED_CONFIGS=${REPO}/experiments/configs/legacy_best_configs_selected.csv
SOURCE_MANIFEST=${REPO}/experiments/jobs/t15_paired_validation.job

if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
if [ ! -r "${SELECTED_CONFIGS}" ]; then
  echo "FATAL: cannot read ${SELECTED_CONFIGS}" >&2
  exit 1
fi

source "${COMMON_SH}"
cd ${REPO}/experiments

VARY=True
if [ "${DS}" = "brightkite" ]; then
  VARY=False
fi

OUT=${RESULTS_ROOT}/table15/${DS}/significance
mkdir -p "${OUT}"

echo "paper table         : 15 (historical job/module number 16)"
echo "validation root     : ${RESULTS_ROOT}"
echo "split resampling    : ${VARY}"
echo "selected configs    : ${SELECTED_CONFIGS}"
echo "Degree EG semantics : legacy directed indegree"
echo "PR/Cl EG semantics  : simple undirected set union"

python -u run_significance.py ${COMMON} \
    --num_seeds 10 --seed_start 0 --vary_split ${VARY} \
    --selected_configs "${SELECTED_CONFIGS}" \
    --cafe_in_lambda ${IN_LF} --cafe_in_beta ${IN_BETA} --cafe_in_lam ${IN_LAM} \
    --cafe_pre_alpha ${PRE_A} --cafe_pre_beta ${PRE_BETA} --cafe_pre_lam ${PRE_LAM} \
    --fusion_beta ${FUSION_BETA} \
    --protocol paired \
    --source_manifest "${SOURCE_MANIFEST}" \
    --use_demographics True \
    --centrality_types pagerank,closeness \
    --out_csv "${OUT}/per_seed_metrics_${DS}.csv" ${EXTRA}

echo "Done."
