#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=08:00:00
#SBATCH --array=0-4%2
#SBATCH --job-name=t04_acc_pilot
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t04_acceptance_pilot_%A_%a.out

# Array tasks: 0=RA, 1=HL-GNN, 2=Fusion, 3=CAFE-In, 4=CAFE-Pre.
# All tasks use Oklahoma, NOT the dataset-array mapping of _common.sh.
# Requires a separately prepared, frozen authority.json at PILOT_ROOT.
set -euo pipefail
REPO=/home/eerdem/workspace/CAFE
PYTHON_BIN=/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python
: "${PILOT_ROOT:?Set PILOT_ROOT to the prepared isolated pilot directory}"
export LD_LIBRARY_PATH=/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}
export PYTHONDONTWRITEBYTECODE=1
# Node-local temporary cache, not the user's almost-full home directory.
TASK_CACHE=$(mktemp -d /tmp/cafe-acceptance-pilot.XXXXXX)
export MPLCONFIGDIR=${TASK_CACHE}
cd "${REPO}"
"${PYTHON_BIN}" -u experiments/pilot_table4_acceptance.py \
    --output-root "${PILOT_ROOT}" --arm-index "${SLURM_ARRAY_TASK_ID}"
