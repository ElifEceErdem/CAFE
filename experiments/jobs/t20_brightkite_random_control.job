#!/bin/bash
#SBATCH --job-name=t20_bk_random
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=72:00:00
#SBATCH --array=0-9%5
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t20_bk_random_%A_%a.out

# Brightkite protocol control: ten paired connectivity-preserving random
# 85/5/10 splits. Task i uses split seed = training seed = 42+i, and all five
# Fig. 4 scorers share that split.
#
# Publishable use is fail-closed. The current checkout still fails the Eq. (8)
# edgewise preflight, and the existing CAFE-In configuration was selected under
# that defective objective. After fixing Eq. (8) and rerunning selection:
#
#   sbatch --export=ALL,\
#BK_RANDOM_SELECTED_CONFIGS=/absolute/new/selected_configs.csv,\
#BK_RANDOM_SELECTION_LINEAGE=/absolute/new/integrity.json \
#     experiments/jobs/t20_brightkite_random_control.job
#
# A legacy implementation run is available only for diagnosis and is labelled
# invalid in every final artifact:
#
#   sbatch --export=ALL,BK_RANDOM_ALLOW_NONEDGEWISE=True \
#     experiments/jobs/t20_brightkite_random_control.job

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

REPO=/home/eerdem/workspace/CAFE
DATA=${REPO}/data/SNAP
TODO3=${REPO}/results_egfix/20260724_degree_eg_sum_in_v1/todo3
DEFAULT_CONFIGS=${TODO3}/selected_configs.csv
DEFAULT_LINEAGE=${TODO3}/finalized/todo3_integrity.json
CAMPAIGN=${BK_RANDOM_CAMPAIGN:-${REPO}/results_rq1_controls/brightkite_random_85_5_10_v1}
ALLOW_NONEDGEWISE=${BK_RANDOM_ALLOW_NONEDGEWISE:-False}
PENALTY_REDUCTION=${BK_RANDOM_PENALTY_REDUCTION:-sum}
CONFIGURATION_ORIGIN=${BK_RANDOM_CONFIGURATION_ORIGIN:-validation_selected}

cd "${REPO}"

TASK_ID=${SLURM_ARRAY_TASK_ID:?submit this file as a Slurm array}
if (( TASK_ID < 0 || TASK_ID > 9 )); then
    echo "ERROR: array task must be in 0..9" >&2
    exit 2
fi
SEED=$((42 + TASK_ID))

case "${ALLOW_NONEDGEWISE}" in
    True|true|1) ALLOW_NONEDGEWISE=True ;;
    False|false|0) ALLOW_NONEDGEWISE=False ;;
    *)
        echo "ERROR: BK_RANDOM_ALLOW_NONEDGEWISE must be True or False" >&2
        exit 2
        ;;
esac
case "${PENALTY_REDUCTION}" in
    mean|sum) ;;
    *)
        echo "ERROR: BK_RANDOM_PENALTY_REDUCTION must be mean or sum" >&2
        exit 2
        ;;
esac
case "${CONFIGURATION_ORIGIN}" in
    validation_selected|legacy_test_selected) ;;
    *)
        echo "ERROR: invalid BK_RANDOM_CONFIGURATION_ORIGIN" >&2
        exit 2
        ;;
esac

EDGEWISE=$(python -c 'from experiments.run_k_sensitivity import _edgewise_penalty_preflight; print(str(_edgewise_penalty_preflight()).lower())')
if [[ "${EDGEWISE}" != "true" && "${ALLOW_NONEDGEWISE}" != "True" ]]; then
    echo "ERROR: Eq. (8) edgewise preflight failed; no GPU work was started." >&2
    echo "Fix the CAFE-In loss and rerun configuration selection first." >&2
    exit 2
fi

if [[ "${ALLOW_NONEDGEWISE}" == "True" ]]; then
    SELECTED_CONFIGS=${BK_RANDOM_SELECTED_CONFIGS:-${DEFAULT_CONFIGS}}
    SELECTION_LINEAGE=${BK_RANDOM_SELECTION_LINEAGE:-${DEFAULT_LINEAGE}}
else
    if [[ -z "${BK_RANDOM_SELECTED_CONFIGS:-}" || -z "${BK_RANDOM_SELECTION_LINEAGE:-}" ]]; then
        echo "ERROR: publishable execution requires explicit newly selected" >&2
        echo "BK_RANDOM_SELECTED_CONFIGS and BK_RANDOM_SELECTION_LINEAGE." >&2
        exit 2
    fi
    SELECTED_CONFIGS=${BK_RANDOM_SELECTED_CONFIGS}
    SELECTION_LINEAGE=${BK_RANDOM_SELECTION_LINEAGE}
fi

[[ -f "${SELECTED_CONFIGS}" ]] || {
    echo "ERROR: selected configurations not found: ${SELECTED_CONFIGS}" >&2
    exit 2
}
[[ -f "${SELECTION_LINEAGE}" ]] || {
    echo "ERROR: selection lineage not found: ${SELECTION_LINEAGE}" >&2
    exit 2
}

LEGACY_BEST_SELECTED=${REPO}/experiments/configs/legacy_best_configs_selected.csv
if [[ "${SELECTED_CONFIGS}" == "${LEGACY_BEST_SELECTED}" ]]; then
    python "${REPO}/experiments/configs/verify_legacy_best_configs.py"
    if [[ "${ALLOW_NONEDGEWISE}" != "True" ||
          "${PENALTY_REDUCTION}" != "mean" ||
          "${CONFIGURATION_ORIGIN}" != "legacy_test_selected" ]]; then
        echo "ERROR: analysis/best_configs.csv requires the explicitly" >&2
        echo "legacy, non-edgewise, mean-reduction execution profile." >&2
        exit 2
    fi
fi

TASK_DIR=${CAMPAIGN}/shards/seed_${SEED}
mkdir -p "${TASK_DIR}"
if [[ -f "${TASK_DIR}/_SUCCESS" ]]; then
    python -u analysis/finalize_brightkite_random_control.py finalize \
        --campaign-dir "${CAMPAIGN}" --if-complete
    exit 0
fi
if [[ -e "${TASK_DIR}/stratified_cafe_brightkite.csv" || \
      -e "${TASK_DIR}/metadata_brightkite.json" ]]; then
    echo "ERROR: incomplete task artifacts already exist in ${TASK_DIR}." >&2
    echo "Move that one seed directory aside before retrying." >&2
    exit 2
fi

export LD_LIBRARY_PATH=/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}
export MPLCONFIGDIR=/tmp/cafe-bk-random-mpl-${SLURM_JOB_ID}-${TASK_ID}
export XDG_CACHE_HOME=/tmp/cafe-bk-random-cache-${SLURM_JOB_ID}-${TASK_ID}
export PYTHONHASHSEED=${SEED}
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

conda list --explicit | sed '/^[[:space:]]*$/d' > "${TASK_DIR}/runtime.conda-explicit.txt"
SELECTED_SHA=$(sha256sum "${SELECTED_CONFIGS}" | awk '{print $1}')
LINEAGE_SHA=$(sha256sum "${SELECTION_LINEAGE}" | awk '{print $1}')
KNOWN_NONEDGEWISE_CONFIG_SHA=57b80781dbd15cc367c8c857d92ff535d63084a20ed2110438185f4e49fb13df
if [[ "${ALLOW_NONEDGEWISE}" != "True" && \
      "${SELECTED_SHA}" == "${KNOWN_NONEDGEWISE_CONFIG_SHA}" ]]; then
    echo "ERROR: the supplied configurations were selected under the" >&2
    echo "known non-edgewise Eq. (8) implementation." >&2
    exit 2
fi
{
    printf 'profile=brightkite_connectivity_preserving_random_85_5_10_v1\n'
    printf 'array_task_id=%s\n' "${TASK_ID}"
    printf 'dataset=brightkite\n'
    printf 'training_seed=%s\n' "${SEED}"
    printf 'split_seed=%s\n' "${SEED}"
    printf 'split_algorithm=connectivity-preserving random\n'
    printf 'train_fraction=0.85\nvalidation_fraction=0.05\ntest_fraction=0.10\n'
    printf 'eq8_edgewise_preflight=%s\n' "${EDGEWISE}"
    printf 'legacy_nonedgewise_override=%s\n' "${ALLOW_NONEDGEWISE}"
    printf 'penalty_reduction=%s\n' "${PENALTY_REDUCTION}"
    printf 'configuration_origin=%s\n' "${CONFIGURATION_ORIGIN}"
    printf 'selected_configs_sha256=%s\n' "${SELECTED_SHA}"
    printf 'selection_lineage_sha256=%s\n' "${LINEAGE_SHA}"
} > "${TASK_DIR}/task.env"

RUN_ARGS=(
    --data_name brightkite
    --data_path "${DATA}"
    --split_file random
    --split_seed "${SEED}"
    --allow_brightkite_random_control True
    --val_ratio 0.05
    --test_ratio 0.10
    --seed "${SEED}"
    --runs 1
    --K 10
    --num_bins 10
    --encoder HLGNN
    --predictor MLP
    --epochs 500
    --batch_size 16384
    --lr 0.001
    --loss_func AUC
    --num_neg 1
    --penalty_reduction "${PENALTY_REDUCTION}"
    --selected_configs "${SELECTED_CONFIGS}"
    --source_manifest "${SELECTION_LINEAGE}"
    --include_fusion True
    --save_recommendations True
    --skip_final_comprehensive_eval True
    --eval_skip_test True
    --eval_max_nodes 5000
    --eval_steps 25
    --patience 6
    --save_dir "${TASK_DIR}"
)

printf '%q ' python -u analysis/run_stratified_cafe.py "${RUN_ARGS[@]}" \
    > "${TASK_DIR}/command.sh"
printf '\n' >> "${TASK_DIR}/command.sh"

python -u analysis/run_stratified_cafe.py "${RUN_ARGS[@]}" \
    2>&1 | tee "${TASK_DIR}/runner.log"

CHECK_ARGS=(
    check
    --task-dir "${TASK_DIR}"
    --seed "${SEED}"
    --selected-configs "${SELECTED_CONFIGS}"
    --edgewise-preflight "${EDGEWISE}"
    --penalty-reduction "${PENALTY_REDUCTION}"
    --configuration-origin "${CONFIGURATION_ORIGIN}"
)
if [[ "${ALLOW_NONEDGEWISE}" == "True" ]]; then
    CHECK_ARGS+=(--legacy-override)
fi
python -u analysis/finalize_brightkite_random_control.py "${CHECK_ARGS[@]}"
python -u analysis/finalize_brightkite_random_control.py finalize \
    --campaign-dir "${CAMPAIGN}" --if-complete

echo "Brightkite random-control shard complete: seed ${SEED}"
