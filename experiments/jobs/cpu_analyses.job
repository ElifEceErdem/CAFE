#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32GB
#SBATCH --time=08:00:00
#SBATCH --job-name=cpu_analyses
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/cpu_analyses_%A.out

# CPU-only analyses that need no training:
#   Table 2   dataset statistics
#   Table 9   group-coreness coupling (Cliff's delta, per-group distributions)
#
# Table 9's uplift join reads the stratified per-node CSVs, so run
# t05_stratified.job first if you want that half populated.

SLURM_ARRAY_TASK_ID=0
# NOTE: under Slurm $0 is a copy of this script in the spool directory, so
# dirname "$0" does NOT point at experiments/jobs. Source by absolute path and
# fail loudly -- set -e lives inside _common.sh, so a silent miss here would
# leave every variable unset and run the python calls from the wrong cwd.
REPO=/home/eerdem/workspace/CAFE
COMMON_SH=${REPO}/experiments/jobs/_common.sh
if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
source "${COMMON_SH}"

cd ${REPO}/analysis

echo "=== Table 2: dataset statistics ==="
python -u generate_dataset_table.py \
    --data_path ${DATA} \
    --out ${REPO}/results_repro/tables/dataset_table.tex

echo "=== Table 9: group-coreness coupling ==="
python -u coreness_by_group.py \
    --datasets oklahoma,unc,pokec_n \
    --data_path ${DATA} \
    --stratified_csv_dir ${REPO}/analysis/plots/stratified_cafe \
    --save_dir ${REPO}/analysis/plots/coreness_by_group

echo "Done."
