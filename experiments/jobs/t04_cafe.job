#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=160:00:00
#SBATCH --array=0-4
#SBATCH --job-name=t04_cafe
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t04_cafe_%A_%a.out

# Tables 4, 7 and 8 -- the CAFE side, at the PUBLISHED configurations.
# Seven arms per dataset: HL-GNN backbone, CAFE^-P, fusion-only control,
# CAFE-In^-B, CAFE-Pre^-B, CAFE-In, CAFE-Pre.
# Array index -> dataset: 0=ego-facebook 1=oklahoma 2=unc 3=pokec_n 4=brightkite
#
# run_cafe_p.py does not accept the fast-eval flags, so it gets ${SPLIT}
# while run_cafe.py gets ${EXTRA}.

# NOTE: under Slurm $0 is a copy of this script in the spool directory, so
# dirname "$0" does NOT point at experiments/jobs. Source by absolute path and
# fail loudly -- set -e lives inside _common.sh, so a silent miss here would
# leave every variable unset and run the python calls from the wrong cwd.
REPO=/home/eerdem/workspace/CAFE
COMMON_SH=${REPO}/experiments/jobs/_common.sh
if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
source "${COMMON_SH}"
cd ${REPO}/experiments
BASE=${RESULTS_ROOT}/${DS}

# CAFE^-P uses its own selected (beta, lambda_mob); see analysis/best_configs.csv
case ${DS} in
  ego-facebook) P_BETA=0.1; P_LAM=0.3 ;;
  oklahoma)     P_BETA=1.0; P_LAM=0.5 ;;
  unc)          P_BETA=2.0; P_LAM=0.5 ;;
  pokec_n)      P_BETA=1.0; P_LAM=0.5 ;;
  brightkite)   P_BETA=1.0; P_LAM=0.5 ;;
esac

# Resubmitting after a mid-job failure re-runs every arm from scratch, which on
# pokec_n/brightkite throws away hours of completed work. Opt in to skipping
# arms that already have a finished (non-.partial) result:
#   sbatch --export=ALL,SKIP_EXISTING=1 t04_cafe.job
# Default 0, so nothing is ever silently reused.
# Optional arm selector, so a dataset that risks the wall clock can be split
# across two GPUs instead of running seven arms in sequence:
#   ARMS=slow  -> the two run_cafe_p.py arms (HL-GNN backbone, CAFE^-P).
#                 These do NOT accept the fast-eval flags, so on Pokec-n they
#                 re-evaluate all 33,550 test-active users every run and are by
#                 far the longest part of the job (~33 h each).
#   ARMS=fast  -> the five run_cafe.py arms, which do get fast-eval.
#   ARMS=all   -> everything (default, unchanged behaviour).
ARMS=${ARMS:-all}

SKIP_EXISTING=${SKIP_EXISTING:-0}

# True only if $1/<glob $2> holds a completed result produced by the CURRENT
# Equality-Gain metric. Checking mere existence is not enough: the pre-2026-07-23
# results are still in this tree, and skipping on those would silently turn the
# corrected-EG rerun into a no-op.
arm_done () {  # $1=outdir  $2=filename glob (default results_*.json)
  [ "${SKIP_EXISTING}" = "1" ] || return 1
  local dir="${BASE}/$1" glob="${2:-results_*.json}"
  "${PYTHON_BIN:-python}" - "$dir" "$glob" <<'PY'
import glob, json, os, sys
d, g = sys.argv[1], sys.argv[2]
for p in sorted(glob.glob(os.path.join(d, g))):
    if p.endswith('.partial.json'):
        continue
    try:
        info = json.load(open(p)).get('experiment_info', {})
    except Exception:
        continue
    if info.get('eg_graph_semantics') == 'simple_undirected_set_union':
        print(os.path.basename(p))
        sys.exit(0)
sys.exit(1)
PY
  local rc=$?
  [ $rc -eq 0 ] && echo "--- skipping $1 on ${DS}: already complete on the corrected EG metric"
  return $rc
}

CP_COMMON="${COMMON} --runs 10 --coreness_alpha 1.0 \
  --use_equality_gain True --use_centrality_gain True"

if [ "${ARMS}" != "fast" ]; then
mkdir -p ${BASE}/cafe_p
if ! arm_done cafe_p "results_cafe_p_baseline_*.json"; then
  echo "=== HL-GNN backbone on ${DS} (beta=0, lambda_mob=0) ==="
  python -u run_cafe_p.py ${CP_COMMON} \
      --beta_ra "0.0" --lambda_mobility "0.0" \
      --results_file ${BASE}/cafe_p/results_cafe_p_baseline_${DS}_${TS}.json ${SPLIT}
fi

if ! arm_done cafe_p "results_cafe_p_${DS}_*.json"; then
  echo "=== CAFE^-P on ${DS} (beta=${P_BETA}, lambda_mob=${P_LAM}) ==="
  python -u run_cafe_p.py ${CP_COMMON} \
      --beta_ra "${P_BETA}" --lambda_mobility "${P_LAM}" \
      --results_file ${BASE}/cafe_p/results_cafe_p_${DS}_${TS}.json ${SPLIT}
fi
fi   # end ARMS != fast

# run_cafe.py takes the penalty strength under a DIFFERENT flag per mode:
#   inproc  -> --lambda_fair    (--preproc_alpha ignored)
#   preproc -> --preproc_alpha  (--lambda_fair ignored)
# Passing --lambda_fair in preproc mode silently leaves --preproc_alpha at its
# default sweep "0.5,1.0,2.0" and the selected alpha is never run.
run_cafe () {  # $1=mode $2=penalty $3=beta $4=lambda_mob $5=boost $6=outdir
  arm_done "$6" && return 0
  mkdir -p ${BASE}/$6
  local pen_flag="--lambda_fair"
  [ "$1" = "preproc" ] && pen_flag="--preproc_alpha"
  echo "=== $6 on ${DS} ($1, $pen_flag=$2, beta=$3, lambda_mob=$4) ==="
  python -u run_cafe.py ${COMMON} --runs 10 \
      --penalization_mode $1 --use_mobility_boost $5 \
      ${pen_flag} "$2" --beta_ra "$3" --lambda_mobility "$4" \
      --coreness_alpha 1.0 ${EG} \
      --results_file ${BASE}/$6/results_$6_${DS}_${TS}.json ${EXTRA}
}

if [ "${ARMS}" != "slow" ]; then
run_cafe inproc  0.0       "0.1,0.5,1.0,2.0,5.0" 0.0        False fusion_only
run_cafe inproc  ${INB_LF} ${INB_BETA}           0.0        False cafe_in_b
run_cafe preproc ${PREB_A} ${PREB_BETA}          0.0        False cafe_pre_b
run_cafe inproc  ${IN_LF}  ${IN_BETA}            ${IN_LAM}  True  cafe_in
run_cafe preproc ${PRE_A}  ${PRE_BETA}           ${PRE_LAM} True  cafe_pre
fi   # end ARMS != slow

echo "Done."
