#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --constraint=TitanRTX
#SBATCH --mem=48GB
#SBATCH --time=166:00:00
#SBATCH --job-name=cl_v1_recovery
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/closeness_v1_recovery_%A_%a.out
set -euo pipefail
: "${CLOSENESS_RECOVERY_ROOT:?Provide prepared recovery directory}"
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export LD_LIBRARY_PATH=/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}
RECOVERY_CACHE=$(mktemp -d /tmp/cafe-cl-recovery.XXXXXX)
export MPLCONFIGDIR=${RECOVERY_CACHE}
cd /home/eerdem/workspace/CAFE
/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python -u experiments/recover_closeness_v1.py \
    --output-root "${CLOSENESS_RECOVERY_ROOT}" --index "${SLURM_ARRAY_TASK_ID}"
