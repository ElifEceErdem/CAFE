#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=100:00:00
#SBATCH --array=0-4
#SBATCH --job-name=t05_strat
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t05_stratified_%A_%a.out

# Source-coreness stratified campaign. One run feeds FOUR artifacts:
#   Table 5   realized coreness bins
#   Table 6a  lowest-bin CAFE-In-minus-fusion precision
#   Table 18  bin size vs stratified Degree EG
#   Figure 4  source-coreness profiles
#
# --save_recommendations True is what lets bin_perturbation_size.py recover the
# EXACT deduplicated per-bin edge count instead of the K|B_g| upper bound.

# NOTE: under Slurm $0 is a copy of this script in the spool directory, so
# dirname "$0" does NOT point at experiments/jobs. Source by absolute path and
# fail loudly -- set -e lives inside _common.sh, so a silent miss here would
# leave every variable unset and run the python calls from the wrong cwd.
REPO=/home/eerdem/workspace/CAFE
COMMON_SH=${REPO}/experiments/jobs/_common.sh
if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
source "${COMMON_SH}"
cd ${REPO}/analysis

python -u run_stratified_cafe.py ${COMMON} \
    --runs 3 --K 10 --num_bins 10 \
    --cafe_in_lambda ${IN_LF} --cafe_in_beta ${IN_BETA} --cafe_in_lam ${IN_LAM} \
    --cafe_pre_alpha ${PRE_A} --cafe_pre_beta ${PRE_BETA} --cafe_pre_lam ${PRE_LAM} \
    --include_fusion True --fusion_beta ${IN_BETA} \
    --save_recommendations True \
    --save_dir ${REPO}/analysis/plots/stratified_cafe ${EXTRA}

echo "Done."
