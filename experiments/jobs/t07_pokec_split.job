#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=96:00:00
#SBATCH --array=3
#SBATCH --job-name=t07_pk
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t07_pokec_%A_%a_%x.out

# Table 7 -- one Pokec-n ablation arm per job, so ci_pre and mb_post run in
# PARALLEL instead of queueing behind ci_in inside t07_ablation.job.
#
# On Pokec-n each arm is ~5 h/run x 10 runs ~= 49 h, so the stock job needs
# roughly 6 days for three arms in sequence.  Splitting brings the two
# outstanding arms down to ~2 days wall clock.
#
# Array is pinned to 3 so _common.sh resolves DS=pokec_n and the published
# lambdas (CI_PRE=0.3, MB_POST=0.1) come from the same table as t07_ablation.
#
#   sbatch --export=ALL,ARM=ci_pre  experiments/jobs/t07_pokec_split.job
#   sbatch --export=ALL,ARM=mb_post experiments/jobs/t07_pokec_split.job
#
# DUPLICATE HAZARD: t07_ablation.job (currently running as 106563_3) will move
# on to ci_pre and then mb_post once its ci_in arm finishes.  Two runs of the
# same configuration in one directory is not harmless -- generate_final_tables
# globs results_repro/{ds}/{arm}/*.json and puts BOTH into the Pareto/ASF
# selection.  Cancel that job once its ci_in result JSON has been written.
#
# Both runners take ${SPLIT}, never ${EXTRA}: run_coreness_inverse.py and
# run_mobility_boost.py do not accept the fast-eval flags that _common.sh puts
# in ${EXTRA} for the large graphs, and would abort on an unrecognised option.

REPO=/home/eerdem/workspace/CAFE
COMMON_SH=${REPO}/experiments/jobs/_common.sh
if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
source "${COMMON_SH}"
cd ${REPO}/experiments

ARM=${ARM:-}
case "${ARM}" in
  ci_pre|mb_post) ;;
  *) echo "FATAL: set ARM=ci_pre or ARM=mb_post via --export=ALL,ARM=..." >&2
     exit 1 ;;
esac

BASE=${REPO}/results_repro/${DS}

# Refuse to run on the reconstructed legacy metric.  These results go into
# results_repro/ to fill Tables 7/8, so they must be on the CORRECTED metric;
# a tree still carrying the t25 legacy paste would silently populate the
# published tree with pre-2026-07-23 Degree EG.
python - <<'PY'
import sys
sys.path[:0] = ['.', '..', '../backbone']
import metrics.equality_gain as eg
if not hasattr(eg, 'SIMPLE_UNDIRECTED'):
    sys.exit("FATAL: metrics/equality_gain.py is the LEGACY reconstruction. "
             "Restore the corrected implementation before filling results_repro/.")
print("preflight OK: corrected simple_undirected EG in use")
PY

echo "=============================================================="
echo "dataset : ${DS}"
echo "arm     : ${ARM}"
echo "lambda  : ci_pre=${CI_PRE}  mb_post=${MB_POST}"
echo "=============================================================="

mkdir -p ${BASE}/${ARM}

if [ "${ARM}" = "ci_pre" ]; then
  echo "=== coreness_inverse_preproc (lambda=${CI_PRE}) on ${DS} ==="
  python -u run_coreness_inverse.py ${COMMON} --runs 10 --coreness_alpha 1.0 ${EG} \
      --fairness_method coreness_inverse_preproc --lambda_fair "${CI_PRE}" \
      --use_stratified False --use_pa_aware False --use_ndkl False \
      --results_file ${BASE}/ci_pre/results_ci_pre_${DS}_${TS}.json ${SPLIT}
else
  echo "=== mb_post (lambda=${MB_POST}) on ${DS} ==="
  python -u run_mobility_boost.py ${COMMON} --runs 10 --coreness_alpha 1.0 ${EG} \
      --reranking_approach boost --boosting_mode continuous \
      --lambda_mobility "${MB_POST}" --lambda_bridge 0.0 \
      --use_stratified False --use_pa_aware False --use_ndkl False \
      --use_degree_plots False \
      --results_file ${BASE}/mb_post/results_mb_post_${DS}_${TS}.json ${SPLIT}
fi

echo "=== done: ${DS} ${ARM} ==="
