#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=48:00:00
#SBATCH --array=2
#SBATCH --job-name=fig01
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/fig01_diagnosis_%A_%a.out

# Figure 1 -- the coreness-stratified diagnosis (Section 4): Precision@10 by
# degree x coreness, and Precision/EG by coreness group, for CN, RA, AA,
# LightGCN and HL-GNN.
#
# Default array=2 (UNC), which is the network shown in the paper. Submit other
# datasets explicitly if you want the appendix panels:
#   sbatch --array=0-4 fig01_diagnosis.job
#
# run_precision_by_coreness.py builds its own parser and takes no --predictor
# and no fast-eval flags, so it gets ${SPLIT} rather than ${EXTRA}.

source "$(dirname "$0")/_common.sh"
cd ${REPO}/analysis

python -u run_precision_by_coreness.py \
    --data_name ${DS} --data_path ${DATA} \
    --encoder HLGNN \
    --epochs 500 --eval_steps 10 --patience 50 \
    --batch_size 16384 --lr 0.001 \
    --runs 3 --K 10 --mode baseline \
    --save_dir ${REPO}/analysis/plots/precision_by_coreness_aggregated ${SPLIT}

echo "Done."
