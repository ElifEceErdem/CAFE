#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=04:00:00
#SBATCH --array=1,2
#SBATCH --job-name=t25_legacy_eg
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t25_legacy_eg_%A_%a.out

# Does the reconstructed pre-2026-07-23 Equality Gain reproduce the published
# Table 4 Degree EG?  CAFE-In and CAFE-Pre only, at the published configs.
#
# Array index -> dataset (from _common.sh): 1=oklahoma 2=unc.  Oklahoma is the
# decisive one: its Jul-19 and Jul-29 runs agree to the last digit on
# Precision@10 (0.2004) and Closeness EG@10 (12.54), so the model output is
# bit-reproducible there and the metric is the only free variable.  UNC's
# precision moved (0.1198 -> 0.1202), so a UNC mismatch is ambiguous.
#
# TARGETS (results_repro/tables/table4_precision_equality_gain.csv):
#   oklahoma CAFE-In   Deg EG@10 = 5.62 +/- 0.13   Prec@10 = 0.2004 +/- 0.0007
#   oklahoma CAFE-Pre  Deg EG@10 = 7.63 +/- 0.33   Prec@10 = 0.1866 +/- 0.0011
#   unc      CAFE-In   Deg EG@10 = 0.24 +/- 0.18   Prec@10 = 0.1198 +/- 0.0004
#   unc      CAFE-Pre  Deg EG@10 = 2.21 +/- 0.49   Prec@10 = 0.1122 +/- 0.0009
#
# Read Precision FIRST.  If it does not reproduce, the run differs from Jul-19
# in more than the metric and the Degree EG comparison proves nothing.
#
# Only metrics/equality_gain.py carries the legacy paste, so Degree EG@10 is
# legacy while PageRank and Closeness EG stay on the corrected semantics
# (centrality_equality_gain.py is untouched).  Expect PR EG near the rerun
# value (~9.08 on oklahoma), NOT the published 9.85.  That is not a failure.

REPO=/home/eerdem/workspace/CAFE
COMMON_SH=${REPO}/experiments/jobs/_common.sh
if [ ! -r "${COMMON_SH}" ]; then
  echo "FATAL: cannot read ${COMMON_SH}" >&2
  exit 1
fi
source "${COMMON_SH}"
cd ${REPO}/experiments

# Results land OUTSIDE results_repro/ on purpose: these are reconstructed-metric
# numbers and must never be picked up by the table generators, which glob
# results_repro/{ds}/{method}/*.json and aggregate everything they find.
OUT=${REPO}/results_legacy_eg_check/${DS}

# Preflight: refuse to run unless the tree really is on the legacy metric.
# Without this the job silently produces corrected numbers and the whole test
# is wasted -- exactly the failure mode this experiment exists to investigate.
python - <<'PY'
import sys
sys.path[:0] = ['.', '..', '../backbone']
import metrics.equality_gain as eg
if hasattr(eg, 'SIMPLE_UNDIRECTED'):
    sys.exit("FATAL: metrics/equality_gain.py is the CORRECTED version. "
             "This job only makes sense with the legacy paste active.")
if not hasattr(eg, '_vectorized_degree_count'):
    sys.exit("FATAL: metrics/equality_gain.py is neither the corrected nor "
             "the legacy implementation. Aborting rather than guessing.")
print("preflight OK: legacy _vectorized_degree_count in use")
PY

echo "=============================================================="
echo "dataset  : ${DS}"
echo "out dir  : ${OUT}"
echo "CAFE-In  : lambda_fair=${IN_LF} beta=${IN_BETA} lambda_mob=${IN_LAM}"
echo "CAFE-Pre : alpha=${PRE_A} beta=${PRE_BETA} lambda_mob=${PRE_LAM}"
echo "=============================================================="

# Same invocation as t04_cafe.job's run_cafe(), including the per-mode penalty
# flag: inproc takes --lambda_fair, preproc takes --preproc_alpha. Passing the
# wrong one leaves the other at its default sweep and runs a different arm.
run_arm () {  # $1=mode $2=penalty $3=beta $4=lambda_mob $5=outdir
  mkdir -p ${OUT}/$5
  local pen_flag="--lambda_fair"
  [ "$1" = "preproc" ] && pen_flag="--preproc_alpha"
  echo "=== $5 on ${DS} ($1, $pen_flag=$2, beta=$3, lambda_mob=$4) ==="
  python -u run_cafe.py ${COMMON} --runs 10 \
      --penalization_mode $1 --use_mobility_boost True \
      ${pen_flag} "$2" --beta_ra "$3" --lambda_mobility "$4" \
      --coreness_alpha 1.0 ${EG} \
      --results_file ${OUT}/$5/results_$5_${DS}_${TS}.json ${EXTRA}
}

run_arm inproc  ${IN_LF} ${IN_BETA}  ${IN_LAM}  cafe_in
run_arm preproc ${PRE_A} ${PRE_BETA} ${PRE_LAM} cafe_pre

echo "=== done: ${DS} ==="
