#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48GB
#SBATCH --time=07:00:00
#SBATCH --array=0-1
#SBATCH --job-name=cl_exact_pilot
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/closeness_exact_pilot_%A_%a.out

# Array 0: Brightkite; 1: Pokec-n. CPU only; no GNN training.
# A successful <=20-minute control gate is required before <=6-hour RA replay.
set -euo pipefail
REPO=/home/eerdem/workspace/CAFE
PYTHON_BIN=/var/scratch/eerdem/miniconda3/envs/hl_gnn/bin/python
: "${EXACT_PILOT_ROOT:?Set EXACT_PILOT_ROOT to a prepared isolated directory}"
DATASETS=(brightkite pokec_n)
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export CUDA_VISIBLE_DEVICES=""
PILOT_CACHE=$(mktemp -d /tmp/cafe-exact-pilot.XXXXXX)
export MPLCONFIGDIR=${PILOT_CACHE}
cd "${REPO}"
"${PYTHON_BIN}" -u analysis/pilot_exact_closeness.py --run \
    --output-root "${EXACT_PILOT_ROOT}" --dataset "${DATASETS[SLURM_ARRAY_TASK_ID]}"
