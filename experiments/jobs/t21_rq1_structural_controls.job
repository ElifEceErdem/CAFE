#!/bin/bash
#SBATCH --job-name=t21_rq1_controls
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=24:00:00
#SBATCH --array=0-4%5
#SBATCH --output=/home/eerdem/workspace/CAFE/experiments/jobs/logs/t21_rq1_controls_%A_%a.out

# Read-only reanalysis of the existing corrected stratified artifacts:
#   1. hit@10 ~ log degree + coreness
#   2. add local clustering coefficient
#   3. add held-out-target opportunity as a sensitivity
#   4. re-bin the same recommendations by local clustering and recompute
#      stratified Degree EG and Spearman gradients.
#
# This job trains no models and requests no GPU. It processes one dataset per
# task and then strictly finalizes only when all five datasets are complete.
# Existing CAFE-In selection predates the outstanding Eq. (8) shape fix; the
# output marks those cells invalid instead of silently treating them as final.

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

REPO=/home/eerdem/workspace/CAFE
DATA=${REPO}/data/SNAP
DEFAULT_UPSTREAM=${REPO}/results_egfix/20260724_degree_eg_sum_in_v1/todo3
UPSTREAM=${RQ1_CONTROLS_UPSTREAM:-${DEFAULT_UPSTREAM}}
CAMPAIGN=${RQ1_CONTROLS_CAMPAIGN:-${REPO}/results_rq1_controls/structural_controls_v1}

TASK_ID=${SLURM_ARRAY_TASK_ID:?submit this file as a Slurm array}
if (( TASK_ID < 0 || TASK_ID > 4 )); then
    echo "ERROR: array task must be in 0..4" >&2
    exit 2
fi
DATASETS=(ego-facebook oklahoma unc pokec_n brightkite)
DATASET=${DATASETS[TASK_ID]}
OUTPUT_DIR=${CAMPAIGN}/shards/${DATASET}

[[ -d "${UPSTREAM}/stratified/${DATASET}" ]] || {
    echo "ERROR: upstream stratified artifacts absent for ${DATASET}" >&2
    exit 2
}
mkdir -p "${OUTPUT_DIR}"

export MPLCONFIGDIR=/tmp/cafe-rq1-controls-mpl-${SLURM_JOB_ID}-${TASK_ID}
export XDG_CACHE_HOME=/tmp/cafe-rq1-controls-cache-${SLURM_JOB_ID}-${TASK_ID}
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK}
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

cd "${REPO}"
printf '%q ' python -u analysis/rq1_structural_controls.py run \
    --dataset "${DATASET}" \
    --data-path "${DATA}" \
    --upstream-root "${UPSTREAM}" \
    --output-dir "${OUTPUT_DIR}" \
    --threads "${SLURM_CPUS_PER_TASK}" > "${OUTPUT_DIR}/command.sh"
printf '\n' >> "${OUTPUT_DIR}/command.sh"
conda list --explicit | sed '/^[[:space:]]*$/d' \
    > "${OUTPUT_DIR}/runtime.conda-explicit.txt"

python -u analysis/rq1_structural_controls.py run \
    --dataset "${DATASET}" \
    --data-path "${DATA}" \
    --upstream-root "${UPSTREAM}" \
    --output-dir "${OUTPUT_DIR}" \
    --threads "${SLURM_CPUS_PER_TASK}" \
    2>&1 | tee "${OUTPUT_DIR}/runner.log"

python -u analysis/rq1_structural_controls.py finalize \
    --campaign-dir "${CAMPAIGN}" --if-complete

echo "RQ1 structural-control task complete: ${DATASET}"
