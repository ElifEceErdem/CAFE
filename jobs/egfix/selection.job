#!/bin/bash
#SBATCH --job-name=egfix_selection
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=120:00:00
#SBATCH --array=0-69%10
#SBATCH --output=/tmp/%x_%A_%a.out

# Array layout:
#   five datasets x two variants x seven training-time penalties = 70 tasks.
# Each task trains one penalty at three paired seeds and evaluates the complete
# 6 beta x 5 mobility grid (30 configurations) on VALIDATION only.

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/experiments/run_cafe.py" &&
              -d "${candidate}/jobs/egfix" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
RUN_TAG="${EGFIX_RUN_TAG:?EGFIX_RUN_TAG was not exported by submit_selection.sh}"
validate_run_tag "${RUN_TAG}" || {
    echo "ERROR: unsafe EGFIX_RUN_TAG: ${RUN_TAG}" >&2
    exit 2
}

TASK_ID="${SLURM_ARRAY_TASK_ID:?selection.job must run as a Slurm array}"
if (( TASK_ID < 0 || TASK_ID > 69 )); then
    echo "ERROR: array index ${TASK_ID} is outside 0..69." >&2
    exit 2
fi

CAMPAIGN="${REPO}/results_egfix/${RUN_TAG}"
SOURCE_MANIFEST="${CAMPAIGN}/source_manifest.json"
[[ -f "${CAMPAIGN}/_PREFLIGHT_COMPLETE" ]] || {
    echo "ERROR: preflight completion marker is absent." >&2
    exit 2
}
cd "${REPO}"
python -u analysis/egfix_preflight.py \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only

IFS=$'\t' read -r DATASET METHOD MODE PENALTY_NAME PENALTY < <(
    python -u experiments/egfix_protocol.py \
        --task-index "${TASK_ID}" \
        --format tsv
)
if [[ "${PENALTY_NAME}" == "lambda_fair" ]]; then
    PENALTY_FLAG="--lambda_fair"
elif [[ "${PENALTY_NAME}" == "preproc_alpha" ]]; then
    PENALTY_FLAG="--preproc_alpha"
else
    echo "ERROR: protocol returned unknown penalty ${PENALTY_NAME}." >&2
    exit 2
fi

TASK_DIR="${CAMPAIGN}/selection/${DATASET}/${METHOD}/task_${TASK_ID}"
if [[ -e "${TASK_DIR}/results.json" || -e "${TASK_DIR}/_SUCCESS" ]]; then
    echo "ERROR: refusing to overwrite a completed selection task: ${TASK_DIR}" >&2
    exit 2
fi
mkdir -p "${TASK_DIR}"

export LD_LIBRARY_PATH="/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}"
export MPLCONFIGDIR="/tmp/cafe-egfix-mpl-${SLURM_JOB_ID}-${TASK_ID}"
export XDG_CACHE_HOME="/tmp/cafe-egfix-cache-${SLURM_JOB_ID}-${TASK_ID}"
export PYTHONHASHSEED=42
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

COMMON_ARGS=(
    --data_name "${DATASET}"
    --data_path "${REPO}/data/SNAP"
    --encoder HLGNN
    --predictor MLP
    --epochs 500
    --eval_steps 10
    --patience 50
    --batch_size 16384
    --lr 0.001
    --runs 3
    --seed 42
    --penalization_mode "${MODE}"
    --use_mobility_boost True
    "${PENALTY_FLAG}" "${PENALTY}"
    --beta_ra "0.0,0.1,0.5,1.0,2.0,5.0"
    --lambda_mobility "0.0,0.1,0.3,0.5,1.0"
    --coreness_alpha 1.0
    --penalty_reduction mean
    --reset_seed_per_model True
    --evaluation_split valid
    --selection_mode True
    --skip_final_comprehensive_eval True
    --k_values 10
    --use_demographics False
    --use_equality_gain True
    --use_centrality_gain True
    --centrality_types pagerank,closeness
    --closeness_seed 42
    --closeness_sample_size 0
    --closeness_epsilon 0.1
    --source_manifest "${SOURCE_MANIFEST}"
    --results_file "${TASK_DIR}/results.json"
)

if [[ "${DATASET}" == "pokec_n" || "${DATASET}" == "brightkite" ]]; then
    COMMON_ARGS+=(
        --eval_skip_test True
        --eval_max_nodes 5000
        --eval_steps 25
        --patience 6
    )
fi
if [[ "${DATASET}" == "brightkite" ]]; then
    COMMON_ARGS+=(
        --split_file "${REPO}/data/SNAP/brightkite/temporal_split.pt"
    )
fi

{
    printf 'run_tag=%s\n' "${RUN_TAG}"
    printf 'slurm_job_id=%s\n' "${SLURM_JOB_ID:-manual}"
    printf 'array_task_id=%s\n' "${TASK_ID}"
    printf 'dataset=%s\n' "${DATASET}"
    printf 'method=%s\n' "${METHOD}"
    printf 'penalization_mode=%s\n' "${MODE}"
    printf 'penalty_name=%s\n' "${PENALTY_NAME}"
    printf 'penalty_value=%s\n' "${PENALTY}"
    printf 'evaluation_split=valid\n'
    printf 'penalty_reduction=mean\n'
    printf 'closeness_seed=42\n'
} > "${TASK_DIR}/task.env"

printf '%q ' python -u experiments/run_cafe.py "${COMMON_ARGS[@]}" \
    > "${TASK_DIR}/command.sh"
printf '\n' >> "${TASK_DIR}/command.sh"

python -u experiments/run_cafe.py "${COMMON_ARGS[@]}"
[[ -s "${TASK_DIR}/results.json" ]] || {
    echo "ERROR: runner returned without a non-empty results.json." >&2
    exit 1
}
touch "${TASK_DIR}/_SUCCESS"
echo "Selection task complete: ${DATASET} ${METHOD} penalty=${PENALTY}"
