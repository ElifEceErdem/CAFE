#!/bin/bash
#SBATCH --job-name=egfix_aggregate
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32GB
#SBATCH --time=72:00:00
#SBATCH --array=0-49%10
#SBATCH --output=/tmp/%x_%A_%a.out

# Five fixed-split datasets x ten headline training seeds (42..51).
# Every task writes one private long-format CSV; no concurrent append occurs.

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/experiments/run_significance.py" &&
              -d "${candidate}/jobs/egfix" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
RUN_TAG="${EGFIX_RUN_TAG:?EGFIX_RUN_TAG was not exported by submit_reruns.sh}"
validate_run_tag "${RUN_TAG}" || {
    echo "ERROR: unsafe EGFIX_RUN_TAG: ${RUN_TAG}" >&2
    exit 2
}
TASK_ID="${SLURM_ARRAY_TASK_ID:?aggregate.job must run as a Slurm array}"
if (( TASK_ID < 0 || TASK_ID > 49 )); then
    echo "ERROR: array index ${TASK_ID} is outside 0..49." >&2
    exit 2
fi

CAMPAIGN="${REPO}/results_egfix/${RUN_TAG}"
SOURCE_MANIFEST="${CAMPAIGN}/source_manifest.json"
SELECTED_CONFIGS="${CAMPAIGN}/selected_configs.csv"
[[ -f "${CAMPAIGN}/_SELECTION_COMPLETE" ]] || {
    echo "ERROR: configuration selection has not been finalized." >&2
    exit 2
}
cd "${REPO}"
python -u analysis/egfix_preflight.py \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only
(cd "${CAMPAIGN}" && sha256sum --check --quiet selected_configs.sha256)

DATASETS=(ego-facebook oklahoma unc pokec_n brightkite)
DATASET_INDEX=$((TASK_ID / 10))
SEED_OFFSET=$((TASK_ID % 10))
DATASET="${DATASETS[DATASET_INDEX]}"
TRAINING_SEED=$((42 + SEED_OFFSET))

TASK_DIR="${CAMPAIGN}/aggregate/${DATASET}/seed_${TRAINING_SEED}"
if [[ -e "${TASK_DIR}/_SUCCESS" ]]; then
    echo "ERROR: refusing to overwrite a completed aggregate task: ${TASK_DIR}" >&2
    exit 2
fi
mkdir -p "${TASK_DIR}"

export LD_LIBRARY_PATH="/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}"
export MPLCONFIGDIR="/tmp/cafe-egfix-mpl-${SLURM_JOB_ID}-${TASK_ID}"
export XDG_CACHE_HOME="/tmp/cafe-egfix-cache-${SLURM_JOB_ID}-${TASK_ID}"
export PYTHONHASHSEED="${TRAINING_SEED}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

COMMON_ARGS=(
    --data_name "${DATASET}"
    --data_path "${REPO}/data/SNAP"
    --epochs 500
    --eval_steps 10
    --patience 50
    --batch_size 16384
    --lr 0.001
    --seed_start "${TRAINING_SEED}"
    --num_seeds 1
    --vary_split False
    --protocol headline
    --selected_configs "${SELECTED_CONFIGS}"
    --penalty_reduction mean
    --skip_final_comprehensive_eval True
    --k_values 10
    --centrality_types pagerank,closeness
    --closeness_seed 42
    --closeness_sample_size 0
    --closeness_epsilon 0.1
    --use_demographics False
    --source_manifest "${SOURCE_MANIFEST}"
    --out_csv "${TASK_DIR}/per_seed_metrics.csv"
)

if [[ "${DATASET}" == "pokec_n" || "${DATASET}" == "brightkite" ]]; then
    COMMON_ARGS+=(
        --eval_skip_test True
        --eval_max_nodes 5000
        --eval_steps 25
        --patience 6
    )
fi
if [[ "${DATASET}" == "brightkite" ]]; then
    COMMON_ARGS+=(
        --split_file "${REPO}/data/SNAP/brightkite/temporal_split.pt"
    )
fi

{
    printf 'run_tag=%s\n' "${RUN_TAG}"
    printf 'slurm_job_id=%s\n' "${SLURM_JOB_ID:-manual}"
    printf 'array_task_id=%s\n' "${TASK_ID}"
    printf 'dataset=%s\n' "${DATASET}"
    printf 'training_seed=%s\n' "${TRAINING_SEED}"
    printf 'split_seed=42\n'
    printf 'evaluation_split=test\n'
    printf 'penalty_reduction=mean\n'
    printf 'closeness_seed=42\n'
} > "${TASK_DIR}/task.env"

printf '%q ' python -u experiments/run_significance.py "${COMMON_ARGS[@]}" \
    > "${TASK_DIR}/command.sh"
printf '\n' >> "${TASK_DIR}/command.sh"

python -u experiments/run_significance.py "${COMMON_ARGS[@]}"
[[ -s "${TASK_DIR}/per_seed_metrics.csv" ]] || {
    echo "ERROR: runner returned without a non-empty metrics CSV." >&2
    exit 1
}
[[ -s "${TASK_DIR}/per_seed_metrics.csv.complete.json" ]] || {
    echo "ERROR: runner returned without its completion manifest." >&2
    exit 1
}
touch "${TASK_DIR}/_SUCCESS"
echo "Aggregate task complete: ${DATASET}, training seed ${TRAINING_SEED}"
