#!/bin/bash
#SBATCH --job-name=egfix_finalize_reruns
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32GB
#SBATCH --time=04:00:00
#SBATCH --output=/tmp/%x_%j.out

# Merge and validate the 50 aggregate tasks and 15 stratified tasks.  This is
# scheduled only after both complete successfully; it does not promote any
# output into the manuscript tree.

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/analysis/egfix_finalize_reruns.py" &&
              -d "${candidate}/jobs/egfix" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
RUN_TAG="${EGFIX_RUN_TAG:?EGFIX_RUN_TAG was not exported by submit_reruns.sh}"
validate_run_tag "${RUN_TAG}" || {
    echo "ERROR: unsafe EGFIX_RUN_TAG: ${RUN_TAG}" >&2
    exit 2
}
CAMPAIGN="${REPO}/results_egfix/${RUN_TAG}"
SOURCE_MANIFEST="${CAMPAIGN}/source_manifest.json"
SELECTED_CONFIGS="${CAMPAIGN}/selected_configs.csv"

cd "${REPO}"
python -u analysis/egfix_preflight.py \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only
(cd "${CAMPAIGN}" && sha256sum --check --quiet selected_configs.sha256)

AGGREGATE_COUNT="$(
    find "${CAMPAIGN}/aggregate" -type f -name _SUCCESS -print | wc -l | tr -d ' '
)"
STRATIFIED_COUNT="$(
    find "${CAMPAIGN}/stratified" -type f -name _SUCCESS -print | wc -l | tr -d ' '
)"
if [[ "${AGGREGATE_COUNT}" != "50" || "${STRATIFIED_COUNT}" != "15" ]]; then
    echo "ERROR: expected 50 aggregate and 15 stratified success markers;" \
         "found ${AGGREGATE_COUNT} and ${STRATIFIED_COUNT}." >&2
    exit 1
fi
if [[ -e "${CAMPAIGN}/_RERUNS_COMPLETE" ]]; then
    echo "ERROR: refusing to overwrite an already-finalized campaign." >&2
    exit 2
fi

export MPLCONFIGDIR="/tmp/cafe-egfix-mpl-${SLURM_JOB_ID:-manual}"
export XDG_CACHE_HOME="/tmp/cafe-egfix-cache-${SLURM_JOB_ID:-manual}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python -u analysis/egfix_finalize_reruns.py \
    --campaign_root "${CAMPAIGN}" \
    --selected_configs "${SELECTED_CONFIGS}" \
    --source_manifest "${SOURCE_MANIFEST}"

[[ -s "${CAMPAIGN}/_RERUNS_COMPLETE" &&
   -s "${CAMPAIGN}/finalized/rerun_integrity.json" ]] || {
    echo "ERROR: rerun finalizer did not write its audited completion artifacts." >&2
    exit 1
}
echo "Corrected-EG campaign finalized: ${CAMPAIGN}"
echo "Outputs remain isolated; no manuscript artifact was overwritten."
