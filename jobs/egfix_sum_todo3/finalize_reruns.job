#!/bin/bash
#SBATCH --job-name=egfix_todo3_finalize
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32GB
#SBATCH --time=04:00:00
#SBATCH --output=/tmp/%x_%j.out

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/jobs/egfix_sum_todo3/finalize_reruns.py" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

verify_runtime_environment() {
    local frozen="$1" current expected
    current="$(mktemp)"
    expected="$(mktemp)"
    conda list --explicit | sed '/^[[:space:]]*$/d' > "${current}"
    sed '/^[[:space:]]*$/d' "${frozen}" > "${expected}"
    cmp -s "${current}" "${expected}" || {
        echo "ERROR: active hl_gnn environment differs from frozen runtime." >&2
        rm -f "${current}" "${expected}"
        return 1
    }
    rm -f "${current}" "${expected}"
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
SUM_RUN_TAG="${EGFIX_SUM_RUN_TAG:?missing EGFIX_SUM_RUN_TAG}"
PRE_RUN_TAG="${EGFIX_PRE_RUN_TAG:?missing EGFIX_PRE_RUN_TAG}"
validate_run_tag "${SUM_RUN_TAG}" && validate_run_tag "${PRE_RUN_TAG}" || {
    echo "ERROR: unsafe upstream run tag." >&2
    exit 2
}

SUM_CAMPAIGN="${REPO}/results_egfix/${SUM_RUN_TAG}"
PRE_CAMPAIGN="${REPO}/results_egfix/${PRE_RUN_TAG}"
CAMPAIGN="${SUM_CAMPAIGN}/todo3"
SOURCE_MANIFEST="${CAMPAIGN}/source_manifest.json"
RUNTIME="${SUM_CAMPAIGN}/hl_gnn.conda-explicit.txt"
cd "${REPO}"

python -u -m jobs.egfix_sum_todo3.provenance \
    --source-manifest "${SOURCE_MANIFEST}" \
    --sum-campaign "${SUM_CAMPAIGN}" \
    --pre-campaign "${PRE_CAMPAIGN}" \
    --repo-root "${REPO}" \
    --verify-only
python -u -m jobs.egfix_sum_todo3.compose_selected_configs \
    --output-dir "${CAMPAIGN}" \
    --source-manifest "${SOURCE_MANIFEST}" \
    --sum-campaign "${SUM_CAMPAIGN}" \
    --pre-campaign "${PRE_CAMPAIGN}" \
    --repo-root "${REPO}" \
    --verify-only
verify_runtime_environment "${RUNTIME}"

AGGREGATE_COUNT="$(
    find "${CAMPAIGN}/aggregate" -type f -name _SUCCESS -print |
        wc -l | tr -d ' '
)"
STRATIFIED_COUNT="$(
    find "${CAMPAIGN}/stratified" -type f -name _SUCCESS -print |
        wc -l | tr -d ' '
)"
if [[ "${AGGREGATE_COUNT}" != "50" ||
      "${STRATIFIED_COUNT}" != "15" ]]; then
    echo "ERROR: expected 50 aggregate and 15 stratified successes;" \
         " found ${AGGREGATE_COUNT} and ${STRATIFIED_COUNT}." >&2
    exit 1
fi

export MPLCONFIGDIR="/tmp/cafe-egfix-todo3-mpl-${SLURM_JOB_ID:-manual}"
export XDG_CACHE_HOME="/tmp/cafe-egfix-todo3-cache-${SLURM_JOB_ID:-manual}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python -u -m jobs.egfix_sum_todo3.finalize_reruns \
    --campaign-root "${CAMPAIGN}" \
    --sum-campaign "${SUM_CAMPAIGN}" \
    --pre-campaign "${PRE_CAMPAIGN}" \
    --repo-root "${REPO}"

[[ -s "${CAMPAIGN}/_TODO3_COMPLETE" &&
   -s "${CAMPAIGN}/finalized/todo3_integrity.json" &&
   -s "${CAMPAIGN}/finalized/target_exposure_integrity.json" ]] || {
    echo "ERROR: TODO3 finalizer did not write authoritative outputs." >&2
    exit 1
}
echo "TODO3 finalized under ${CAMPAIGN}; manuscript files were untouched."
