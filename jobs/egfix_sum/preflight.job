#!/bin/bash
#SBATCH --job-name=egfix_sum_preflight
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16GB
#SBATCH --time=02:00:00
#SBATCH --output=/tmp/%x_%j.out

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/experiments/run_cafe.py" &&
              -d "${candidate}/jobs/egfix_sum" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
RUN_TAG="${EGFIX_SUM_RUN_TAG:?EGFIX_SUM_RUN_TAG was not exported}"
validate_run_tag "${RUN_TAG}" || {
    echo "ERROR: unsafe EGFIX_SUM_RUN_TAG: ${RUN_TAG}" >&2
    exit 2
}

CAMPAIGN="${REPO}/results_egfix/${RUN_TAG}"
SOURCE_MANIFEST="${CAMPAIGN}/source_manifest.json"
[[ -d "${CAMPAIGN}" && -s "${SOURCE_MANIFEST}" ]] || {
    echo "ERROR: campaign or source manifest is missing: ${CAMPAIGN}" >&2
    exit 2
}

cd "${REPO}"
export LD_LIBRARY_PATH="/cm/local/apps/cuda-driver/libs/current/lib64:${LD_LIBRARY_PATH:-}"
export MPLCONFIGDIR="/tmp/cafe-egfix-sum-mpl-${SLURM_JOB_ID:-manual}"
export XDG_CACHE_HOME="/tmp/cafe-egfix-sum-cache-${SLURM_JOB_ID:-manual}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python -u -m jobs.egfix_sum.provenance \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only

RUNTIME_ENV="${CAMPAIGN}/hl_gnn.conda-explicit.txt"
RUNTIME_ENV_DIGEST="${CAMPAIGN}/hl_gnn.conda-explicit.sha256"
if [[ -e "${RUNTIME_ENV}" || -e "${RUNTIME_ENV_DIGEST}" ]]; then
    [[ -s "${RUNTIME_ENV}" && -s "${RUNTIME_ENV_DIGEST}" ]] || {
        echo "ERROR: incomplete runtime-environment attestation." >&2
        exit 2
    }
else
    RUNTIME_ENV_TEMP="${RUNTIME_ENV}.tmp.${SLURM_JOB_ID:-manual}"
    conda list --explicit > "${RUNTIME_ENV_TEMP}"
    [[ -s "${RUNTIME_ENV_TEMP}" ]] || {
        echo "ERROR: conda produced an empty environment snapshot." >&2
        exit 1
    }
    mv "${RUNTIME_ENV_TEMP}" "${RUNTIME_ENV}"
    (
        cd "${CAMPAIGN}"
        sha256sum hl_gnn.conda-explicit.txt \
            > hl_gnn.conda-explicit.sha256
    )
fi
RECORDED_ENV_SHA="$(awk 'NR == 1 {print $1}' "${RUNTIME_ENV_DIGEST}")"
CURRENT_ENV_SHA="$(conda list --explicit | sha256sum | awk '{print $1}')"
[[ "${CURRENT_ENV_SHA}" == "${RECORDED_ENV_SHA}" ]] || {
    echo "ERROR: active hl_gnn environment differs from campaign snapshot." >&2
    exit 2
}

python -m unittest discover -s tests -p 'test_*.py' -v
python -m jobs.egfix_sum.tests -v

python -u -m jobs.egfix_sum.provenance \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only

touch "${CAMPAIGN}/_CAFE_IN_SUM_PREFLIGHT_COMPLETE"
echo "CAFE-In/sum preflight passed: ${CAMPAIGN}"
