#!/bin/bash
#SBATCH --job-name=egfix_sum_finalize
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32GB
#SBATCH --time=02:00:00
#SBATCH --output=/tmp/%x_%j.out

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/jobs/egfix_sum/finalize_selection.py" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
RUN_TAG="${EGFIX_SUM_RUN_TAG:?EGFIX_SUM_RUN_TAG was not exported}"
validate_run_tag "${RUN_TAG}" || {
    echo "ERROR: unsafe EGFIX_SUM_RUN_TAG: ${RUN_TAG}" >&2
    exit 2
}
CAMPAIGN="${REPO}/results_egfix/${RUN_TAG}"
SOURCE_MANIFEST="${CAMPAIGN}/source_manifest.json"
RUNTIME_ENV="${CAMPAIGN}/hl_gnn.conda-explicit.txt"
RUNTIME_ENV_DIGEST="${CAMPAIGN}/hl_gnn.conda-explicit.sha256"

cd "${REPO}"
python -u -m jobs.egfix_sum.provenance \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only
[[ -s "${RUNTIME_ENV}" && -s "${RUNTIME_ENV_DIGEST}" ]] || {
    echo "ERROR: runtime-environment attestation is absent." >&2
    exit 2
}
RECORDED_ENV_SHA="$(awk 'NR == 1 {print $1}' "${RUNTIME_ENV_DIGEST}")"
[[ "$(sha256sum "${RUNTIME_ENV}" | awk '{print $1}')" == "${RECORDED_ENV_SHA}" ]] || {
    echo "ERROR: runtime-environment snapshot digest is invalid." >&2
    exit 2
}
CURRENT_ENV_SHA="$(conda list --explicit | sha256sum | awk '{print $1}')"
[[ "${CURRENT_ENV_SHA}" == "${RECORDED_ENV_SHA}" ]] || {
    echo "ERROR: active hl_gnn environment differs from campaign snapshot." >&2
    exit 2
}

SUCCESS_COUNT="$(
    find "${CAMPAIGN}/selection" -type f -name _SUCCESS -print |
        wc -l | tr -d ' '
)"
if [[ "${SUCCESS_COUNT}" != "35" ]]; then
    echo "ERROR: expected 35 success markers; found ${SUCCESS_COUNT}." >&2
    exit 1
fi
if [[ -e "${CAMPAIGN}/_CAFE_IN_SUM_SELECTION_COMPLETE" ]]; then
    echo "ERROR: selection is already finalized." >&2
    exit 2
fi

python -u -m jobs.egfix_sum.finalize_selection \
    --campaign_root "${CAMPAIGN}" \
    --source_manifest "${SOURCE_MANIFEST}"

python -u -m jobs.egfix_sum.provenance \
    --source_manifest "${SOURCE_MANIFEST}" \
    --verify-only
CURRENT_ENV_SHA="$(conda list --explicit | sha256sum | awk '{print $1}')"
[[ "${CURRENT_ENV_SHA}" == "${RECORDED_ENV_SHA}" ]] || {
    echo "ERROR: hl_gnn environment changed during finalization." >&2
    exit 2
}

[[ -s "${CAMPAIGN}/selected_cafe_in_configs.csv" ]] || {
    echo "ERROR: finalizer did not create selected_cafe_in_configs.csv." >&2
    exit 1
}
(
    cd "${CAMPAIGN}"
    sha256sum selected_cafe_in_configs.csv \
        > selected_cafe_in_configs.sha256
)
touch "${CAMPAIGN}/_CAFE_IN_SUM_SELECTION_COMPLETE"

echo "CAFE-In/sum selection frozen at:"
echo "  ${CAMPAIGN}/selected_cafe_in_configs.csv"
echo "This five-row artifact is for TODO2 audit; it is not phase-two input."
