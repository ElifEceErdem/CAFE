#!/bin/bash
#SBATCH --job-name=egfix_sum_rec_pick
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32GB
#SBATCH --time=02:00:00
#SBATCH --output=/tmp/%x_%j.out

set -eo pipefail
if [[ -f "${HOME}/.bashrc" ]]; then
    source "${HOME}/.bashrc"
fi
conda activate hl_gnn
set -u

discover_repo() {
    local script_dir candidate
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    for candidate in \
        "${CAFE_REPO:-}" \
        "${SLURM_SUBMIT_DIR:-}" \
        "${SLURM_SUBMIT_DIR:-}/.." \
        "${SLURM_SUBMIT_DIR:-}/../.." \
        "${script_dir}" \
        "${script_dir}/.." \
        "${script_dir}/../.."; do
        if [[ -n "${candidate}" &&
              -f "${candidate}/jobs/egfix_sum_recovery/finalize_selection.py" ]]; then
            (cd -- "${candidate}" && pwd -P)
            return 0
        fi
    done
    return 1
}

validate_run_tag() {
    local value="$1"
    [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        [[ "${value}" != *".."* ]] &&
        [[ "$(basename -- "${value}")" == "${value}" ]]
}

REPO="$(discover_repo)" || {
    echo "ERROR: could not locate the CAFE repository." >&2
    exit 2
}
RUN_TAG="${EGFIX_SUM_RUN_TAG:?EGFIX_SUM_RUN_TAG was not exported}"
validate_run_tag "${RUN_TAG}" || {
    echo "ERROR: unsafe EGFIX_SUM_RUN_TAG: ${RUN_TAG}" >&2
    exit 2
}
CAMPAIGN="${REPO}/results_egfix/${RUN_TAG}"
RECOVERY_MANIFEST="${CAMPAIGN}/recovery_manifest.json"
RUNTIME_ENV="${CAMPAIGN}/hl_gnn.conda-explicit.txt"
RUNTIME_ENV_DIGEST="${CAMPAIGN}/hl_gnn.conda-explicit.sha256"

cd "${REPO}"
python -u -m jobs.egfix_sum_recovery.provenance \
    --campaign-root "${CAMPAIGN}" \
    --manifest-path "${RECOVERY_MANIFEST}" \
    --verify-only

RECORDED_ENV_SHA="$(awk 'NR == 1 {print $1}' "${RUNTIME_ENV_DIGEST}")"
CURRENT_ENV_SHA="$(conda list --explicit | sha256sum | awk '{print $1}')"
[[ "${CURRENT_ENV_SHA}" == "${RECORDED_ENV_SHA}" ]] || {
    echo "ERROR: active hl_gnn environment differs from campaign snapshot." >&2
    exit 2
}

SUCCESS_COUNT="$(
    find "${CAMPAIGN}/selection" -type f -name _SUCCESS -print |
        wc -l | tr -d ' '
)"
if (( SUCCESS_COUNT < 28 || SUCCESS_COUNT > 35 )); then
    echo "ERROR: expected 28 successes before adoption, or up to 35 while resuming adoption; found ${SUCCESS_COUNT}." >&2
    exit 1
fi

# Re-audit all original artifacts with all 35 results now present, then record
# or resume the narrow adoption of only tasks 13,17-22.
python -u -m jobs.egfix_sum_recovery.audit_completed \
    --campaign-root "${CAMPAIGN}" \
    --recovery-manifest "${RECOVERY_MANIFEST}" \
    --adopt

SUCCESS_COUNT="$(
    find "${CAMPAIGN}/selection" -type f -name _SUCCESS -print |
        wc -l | tr -d ' '
)"
[[ "${SUCCESS_COUNT}" == "35" ]] || {
    echo "ERROR: adoption did not yield 35 success markers." >&2
    exit 1
}

python -u -m jobs.egfix_sum_recovery.finalize_selection \
    --campaign-root "${CAMPAIGN}"

python -u -m jobs.egfix_sum_recovery.provenance \
    --campaign-root "${CAMPAIGN}" \
    --manifest-path "${RECOVERY_MANIFEST}" \
    --verify-only

[[ -s "${CAMPAIGN}/selected_cafe_in_configs.csv" &&
   -s "${CAMPAIGN}/cafe_in_sum_recovery_lineage.json" ]] || {
    echo "ERROR: recovery finalizer outputs are incomplete." >&2
    exit 1
}
(
    cd "${CAMPAIGN}"
    sha256sum selected_cafe_in_configs.csv \
        > selected_cafe_in_configs.sha256
)
touch "${CAMPAIGN}/_CAFE_IN_SUM_SELECTION_COMPLETE"

echo "Recovered TODO1 selection frozen at:"
echo "  ${CAMPAIGN}/selected_cafe_in_configs.csv"
echo "Stop here for TODO2 audit; no phase-two jobs were submitted."
