#!/bin/bash
#SBATCH --job-name=cafe_t08
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=96:00:00
#SBATCH --array=1-3
#SBATCH --output=logs/%x_%A_%a.out
#
# Tables 8, 9 and 16: demographic fairness on the attributed datasets
# (array 1 oklahoma, 2 unc, 3 pokec_n).
#  - fixed split: FairAdj/LBA/MORAL, the CAFE variants and the HL-GNN backbone,
#    tabulated by analysis/generate_table5.py;
#  - split-resampled: experiments/run_significance.py, seeds 0-9 (Table 16);
#  - group/coreness association: analysis/coreness_by_group.py (Table 9).
# Table 9's "more exposed" column uses the exposure runs of t06_localization.job.
#
#   sbatch reproduce/jobs/t08_demographic.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t08_demographic.job
JOB_NAME=t08_demographic
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"
R=${OUT}/results_repro

if [[ "${STAGE}" == "build" ]]; then
    (cd analysis && run_py generate_table5.py --base_dir "${R}" --out_dir "${R}/tables" --include_fusion True \
        && run_py coreness_by_group.py --datasets oklahoma,unc,pokec_n --data_path "${DATA}" \
               --save_dir "${OUT}/analysis/plots/coreness_by_group")
    build_and_verify T08 T09 T16
    exit 0
fi
[[ "${DS}" =~ ^(oklahoma|unc|pokec_n)$ ]] || { echo "Table 8 covers oklahoma, unc, pokec_n only"; exit 0; }

cd experiments
run_py run_baselines.py --data_name "${DS}" --data_path "${DATA}" --encoder HLGNN --methods fairadj,lba,moral \
    --runs 10 --seed 42 --epochs 300 --batch_size 16384 \
    --use_equality_gain True --use_centrality_gain True --centrality_types pagerank,closeness --results_dir "${R}"
mkdir -p "${R}/demographic_backbone" "${R}/${DS}"/{cafe_p,fusion_only,cafe_in_b,cafe_pre_b,cafe_in,cafe_pre}
run_py run_cafe_p.py ${COMMON} --runs 10 --coreness_alpha 1.0 --use_equality_gain True --use_centrality_gain True \
    --beta_ra 0.0 --lambda_mobility 0.0 --results_file "${R}/demographic_backbone/results_cafe_p_baseline_${DS}.json"
run_py run_cafe_p.py ${COMMON} --runs 10 --coreness_alpha 1.0 --use_equality_gain True --use_centrality_gain True \
    --beta_ra "${P_BETA}" --lambda_mobility "${P_LAM}" --results_file "${R}/${DS}/cafe_p/results_cafe_p_${DS}.json"
cafe () {  # $1 mode, $2 penalty, $3 beta, $4 lambda_mob, $5 boost, $6 dir
    local pen=--lambda_fair
    [[ "$1" == "preproc" ]] && pen=--preproc_alpha
    run_py run_cafe.py ${COMMON} --runs 10 --coreness_alpha 1.0 ${EG} --use_demographics True \
        --penalization_mode "$1" --use_mobility_boost "$5" ${pen} "$2" --beta_ra "$3" --lambda_mobility "$4" \
        --results_file "${R}/${DS}/$6/results_$6_${DS}.json" ${EXTRA}
}
cafe inproc  0.0         "0.1,0.5,1.0,2.0,5.0" 0.0          False fusion_only
cafe inproc  "${INB_LF}" "${INB_BETA}"         0.0          False cafe_in_b
cafe preproc "${PREB_A}" "${PREB_BETA}"        0.0          False cafe_pre_b
cafe inproc  "${IN_LF}"  "${IN_BETA}"          "${IN_LAM}"  True  cafe_in
cafe preproc "${PRE_A}"  "${PRE_BETA}"         "${PRE_LAM}" True  cafe_pre
mkdir -p "${R}/demographic_significance"
run_py run_significance.py ${COMMON} --num_seeds 10 --seed_start 0 --vary_split True \
    --cafe_in_lambda "${IN_LF}" --cafe_in_beta "${IN_BETA}" --cafe_in_lam "${IN_LAM}" \
    --cafe_pre_alpha "${PRE_A}" --cafe_pre_beta "${PRE_BETA}" --cafe_pre_lam "${PRE_LAM}" \
    --fusion_beta "${FUSION_BETA}" --use_demographics True --centrality_types pagerank,closeness \
    --out_csv "${R}/demographic_significance/per_seed_metrics_${DS}.csv" ${EXTRA}
