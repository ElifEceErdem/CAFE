#!/bin/bash
#SBATCH --job-name=cafe_t04
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=96:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%A_%a.out
#
# Table 4 (and Figure 3): every method on every dataset at the published
# configuration, 10 fixed-split runs (seeds 42-51; heuristics once).
# Array index -> dataset: 0 ego-facebook, 1 oklahoma, 2 unc, 3 pokec_n, 4 brightkite.
#
#   sbatch reproduce/jobs/t04_main_results.job                      # all datasets
#   sbatch --array=1 --export=ALL,ARMS=cafe-in reproduce/jobs/t04_main_results.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t04_main_results.job  # after all tasks
#   (or: reproduce/jobs/submit.sh t04_main_results)
#
# ARMS: any of baselines,hl-gnn,cafe-in,cafe-pre (default: all).  Pokec-n
# FairAdj/LBA need a large-memory GPU (--constraint=TitanRTX on DAS-5); the
# HL-GNN backbone on Pokec-n takes about 33 h.
# A rerun matches the paper only statistically: build with TOLERANCE (printed
# units, e.g. TOLERANCE=5 accepts 0.05 on EG and 0.0005 on precision).
JOB_NAME=t04_main_results
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"

if [[ "${STAGE}" == "build" ]]; then
    build_and_verify T04 F03
    exit 0
fi

ARMS=${ARMS:-baselines,hl-gnn,cafe-in,cafe-pre}
has () { [[ ",${ARMS}," == *",$1,"* ]]; }
D=${OUT}/${DS}

if has baselines; then
    METHODS="random,pa,cn,aa,ra,lightgcn,ssnet,cross_link_bias,ltlp,tailsteak"
    [[ "${DS}" =~ ^(oklahoma|unc|pokec_n)$ ]] && METHODS="${METHODS},fairadj,lba,moral"
    runner "${D}/baselines" run_baselines.py --data_name "${DS}" --data_path "${DATA}" --encoder HLGNN \
        --methods "${METHODS}" --runs 10 --seed 42 --epochs 300 --batch_size 16384 \
        --use_equality_gain True --use_centrality_gain True --centrality_types pagerank,closeness \
        --results_dir "${D}/baselines" ${SPLIT}
fi
if has hl-gnn; then
    runner "${D}/hl-gnn" run_cafe_p.py ${COMMON} --runs 10 --coreness_alpha 1.0 \
        --use_equality_gain True --use_centrality_gain True \
        --beta_ra 0.0 --lambda_mobility 0.0 --results_file "${D}/hl-gnn/main_results.json" ${SPLIT}
fi
if has cafe-in; then
    runner "${D}/cafe-in" run_cafe.py ${COMMON} --runs 10 --coreness_alpha 1.0 ${EG} \
        --penalization_mode inproc --use_mobility_boost True \
        --lambda_fair "${IN_LF}" --beta_ra "${IN_BETA}" --lambda_mobility "${IN_LAM}" \
        --results_file "${D}/cafe-in/main_results.json" ${EXTRA}
fi
if has cafe-pre; then
    runner "${D}/cafe-pre" run_cafe.py ${COMMON} --runs 10 --coreness_alpha 1.0 ${EG} \
        --penalization_mode preproc --use_mobility_boost True \
        --preproc_alpha "${PRE_A}" --beta_ra "${PRE_BETA}" --lambda_mobility "${PRE_LAM}" \
        --results_file "${D}/cafe-pre/main_results.json" ${EXTRA}
fi
