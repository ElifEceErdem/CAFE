#!/bin/bash
#SBATCH --job-name=cafe_t15
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=96:00:00
#SBATCH --array=0-49%10
#SBATCH --output=logs/%x_%A_%a.out
#
# Table 15: split-resampled paired contrasts.  Task i -> dataset i/10, seed
# s = i%10.  Every arm trains once with training seed s on split s
# (experiments/run_with.py --split-seed); Brightkite keeps its temporal split.
# Outputs: <OUT>/t15/<ds>/seed_<s>/<arm>/.
#
#   sbatch reproduce/jobs/t15_paired_contrasts.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t15_paired_contrasts.job
JOB_NAME=t15_paired_contrasts
TASK=${SLURM_ARRAY_TASK_ID:-0}
DATASETS_T15=(ego-facebook oklahoma unc pokec_n brightkite)
export DS=${DS:-${DATASETS_T15[$((TASK / 10))]}}
SEED=${SEED:-$((TASK % 10))}
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"

if [[ "${STAGE}" == "build" ]]; then
    build_and_verify T15
    exit 0
fi

B=${OUT}/t15/${DS}/seed_${SEED}
RUN_WITH_OPTS="--split-seed ${SEED}"
COMMON_1=${COMMON/--data_name/--runs 1 --seed ${SEED} --data_name}

runner "${B}/ra" run_baselines.py --data_name "${DS}" --data_path "${DATA}" --encoder HLGNN \
    --methods random,pa,cn,aa,ra --runs 1 --seed "${SEED}" --epochs 300 --batch_size 16384 \
    --use_equality_gain True --use_centrality_gain True --centrality_types pagerank,closeness \
    --results_dir "${B}/ra" ${SPLIT}
runner "${B}/hl-gnn" run_cafe_p.py ${COMMON_1} --coreness_alpha 1.0 \
    --use_equality_gain True --use_centrality_gain True --beta_ra 0.0 --lambda_mobility 0.0 \
    --results_file "${B}/hl-gnn/main_results.json" ${SPLIT}
cafe () {  # $1 mode, $2 penalty, $3 beta, $4 lambda_mob, $5 boost, $6 arm
    local pen=--lambda_fair
    [[ "$1" == "preproc" ]] && pen=--preproc_alpha
    runner "${B}/$6" run_cafe.py ${COMMON_1} --coreness_alpha 1.0 ${EG} \
        --penalization_mode "$1" --use_mobility_boost "$5" ${pen} "$2" --beta_ra "$3" --lambda_mobility "$4" \
        --results_file "${B}/$6/main_results.json" ${EXTRA}
}
cafe inproc  0.0        "${FUSION_BETA}" 0.0          False fusion
cafe inproc  "${IN_LF}" "${IN_BETA}"     "${IN_LAM}"  True  cafe-in
cafe preproc "${PRE_A}" "${PRE_BETA}"    "${PRE_LAM}" True  cafe-pre
