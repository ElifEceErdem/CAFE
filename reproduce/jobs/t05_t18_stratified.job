#!/bin/bash
#SBATCH --job-name=cafe_t05_t18
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=72:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%A_%a.out
#
# Tables 5 and 18(a,c), Figure 4: source-coreness stratified profiles.
# Run stage: analysis/run_stratified_cafe.py (RA, HL-GNN, fusion, CAFE-In,
# CAFE-Pre; 3 runs; 10 requested bins).  Build stage: per-bin perturbation
# summary (analysis/bin_perturbation_size.py), Figure 4 inputs, tables.
# Table 18(b) comes from t18_structural_controls.job.
#
#   sbatch reproduce/jobs/t05_t18_stratified.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t05_t18_stratified.job
JOB_NAME=t05_t18_stratified
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"
STRAT=${OUT}/analysis/plots/stratified_cafe

if [[ "${STAGE}" == "build" ]]; then
    run_py analysis/bin_perturbation_size.py --stratified_dir "${STRAT}" --npz_dir "${STRAT}" \
        --out_dir "${OUT}/analysis/plots/bin_perturbation"
    # Figure 4 uses the Oklahoma and Brightkite profiles of the same runs.
    mkdir -p "${OUT}/analysis/plots/stratified_figure4"
    for ds in oklahoma brightkite; do
        cp "${STRAT}/stratified_cafe_${ds}.csv" "${STRAT}"/eg_by_coreness_cafe_${ds}*.csv \
           "${OUT}/analysis/plots/stratified_figure4/" 2>/dev/null || true
    done
    run_py -m reproduce.tools.derive_stratified --root "${OUT}"
    build_and_verify T05 T18 F04
    exit 0
fi

(cd analysis && run_py run_stratified_cafe.py ${COMMON} --runs 3 --K 10 --num_bins 10 \
    --cafe_in_lambda "${IN_LF}" --cafe_in_beta "${IN_BETA}" --cafe_in_lam "${IN_LAM}" \
    --cafe_pre_alpha "${PRE_A}" --cafe_pre_beta "${PRE_BETA}" --cafe_pre_lam "${PRE_LAM}" \
    --include_fusion True --fusion_beta "${FUSION_BETA_MATCHED}" --save_recommendations True \
    --save_dir "${STRAT}" ${EXTRA})
