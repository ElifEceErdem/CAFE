#!/bin/bash
#SBATCH --job-name=cafe_t17
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=72:00:00
#SBATCH --array=0-9%5
#SBATCH --output=logs/%x_%A_%a.out
#
# Table 17: Brightkite random-split control.  Task i uses split seed =
# training seed = 42+i (connectivity-preserving random 85/5/10 split) and the
# paper's configurations (legacy profile: mean penalty reduction, configurations
# of configs/best_configs.csv).  The build stage runs
# analysis/finalize_brightkite_random_control.py and verifies Table 17.
#
#   sbatch reproduce/jobs/t17_brightkite_random.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t17_brightkite_random.job
JOB_NAME=t17_brightkite_random
export DS=brightkite
TOLERANCE=${TOLERANCE:-20}
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"
CAMPAIGN=${OUT}/results_rq1_controls/brightkite_random_85_5_10_v1
CONFIGS=${REPO}/experiments/configs/legacy_best_configs_selected.csv
LINEAGE=${REPO}/experiments/configs/legacy_best_configs_lineage.json

if [[ "${STAGE}" == "build" ]]; then
    run_py analysis/finalize_brightkite_random_control.py finalize --campaign-dir "${CAMPAIGN}" --if-complete
    build_and_verify T17
    exit 0
fi

SEED=$((42 + ${SLURM_ARRAY_TASK_ID:-0}))
TASK_DIR=${CAMPAIGN}/shards/seed_${SEED}
mkdir -p "${TASK_DIR}"
run_py analysis/run_stratified_cafe.py --data_name brightkite --data_path "${DATA}" \
    --split_file random --split_seed "${SEED}" --allow_brightkite_random_control True \
    --val_ratio 0.05 --test_ratio 0.10 --seed "${SEED}" --runs 1 --K 10 --num_bins 10 \
    --encoder HLGNN --predictor MLP --epochs 500 --batch_size 16384 --lr 0.001 --loss_func AUC --num_neg 1 \
    --penalty_reduction mean --selected_configs "${CONFIGS}" --source_manifest "${LINEAGE}" \
    --include_fusion True --save_recommendations True --skip_final_comprehensive_eval True \
    --eval_skip_test True --eval_max_nodes 5000 --eval_steps 25 --patience 6 --save_dir "${TASK_DIR}"
run_py analysis/finalize_brightkite_random_control.py check --task-dir "${TASK_DIR}" --seed "${SEED}" \
    --selected-configs "${CONFIGS}" --edgewise-preflight false --legacy-override --penalty-reduction mean
