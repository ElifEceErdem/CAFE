#!/bin/bash
#SBATCH --job-name=cafe_f01
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x_%j.out
#
# Figure 1: coreness-stratified diagnosis on UNC (CN, RA, AA, LightGCN,
# HL-GNN; 3 runs), then the heatmap and profile panels.
#
#   sbatch reproduce/jobs/f01_diagnosis.job
JOB_NAME=f01_diagnosis
export DS=unc
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"
DIAG=${OUT}/analysis/plots/precision_by_coreness_aggregated

(cd analysis && run_py run_precision_by_coreness.py --data_name unc --data_path "${DATA}" --encoder HLGNN \
    --epochs 500 --eval_steps 10 --patience 50 --batch_size 16384 --lr 0.001 --runs 3 --K 10 \
    --mode baseline --save_dir "${DIAG}")
run_py -m reproduce.tools.derive_stratified --root "${OUT}"
build_and_verify F01
