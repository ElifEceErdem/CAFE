#!/bin/bash
#SBATCH --job-name=cafe_t06
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=96:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%A_%a.out
#
# Table 6: CAFE-In versus the matched fusion control.
#  (a) source side: stratified precision over 10 reruns with the fusion arm
#      -> <OUT>/results_repro/localization/stratified_cafe_<ds>.csv
#  (b) target side: per-node exposure of experiments/run_exposure_acceptance.py
#      -> tier/group summaries (python -m reproduce.tools.derive_exposure).
# The exposure runs also feed Table 9 ("more exposed" group).
#
#   sbatch reproduce/jobs/t06_localization.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t06_localization.job
JOB_NAME=t06_localization
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"
EXPOSURE=${OUT}/analysis/plots/coreness_by_group

if [[ "${STAGE}" == "build" ]]; then
    run_py -m reproduce.tools.derive_exposure --in_dir "${EXPOSURE}" --out_dir "${EXPOSURE}"
    build_and_verify T06 T09
    exit 0
fi

mkdir -p "${EXPOSURE}" "${OUT}/results/${DS}/acceptance_eg"
(cd experiments && run_py run_exposure_acceptance.py ${COMMON} --runs 10 --K 10 \
    --cafe_in_lambda "${IN_LF}" --cafe_in_beta "${IN_BETA}" --cafe_in_lam "${IN_LAM}" \
    --cafe_pre_alpha "${PRE_A}" --cafe_pre_beta "${PRE_BETA}" --cafe_pre_lam "${PRE_LAM}" \
    --fusion_beta "${FUSION_BETA_MATCHED}" --use_sampling_closeness True --tercile_closure left \
    --acceptance_csv "${OUT}/results/${DS}/acceptance_eg/acceptance_eg_${DS}.csv" \
    --exposure_dir "${EXPOSURE}" ${EXTRA})
(cd analysis && run_py run_stratified_cafe.py ${COMMON} --runs 10 --K 10 --num_bins 10 \
    --cafe_in_lambda "${IN_LF}" --cafe_in_beta "${IN_BETA}" --cafe_in_lam "${IN_LAM}" \
    --cafe_pre_alpha "${PRE_A}" --cafe_pre_beta "${PRE_BETA}" --cafe_pre_lam "${PRE_LAM}" \
    --include_fusion True --fusion_beta "${FUSION_BETA_MATCHED}" \
    --save_dir "${OUT}/results_repro/localization" ${EXTRA})
