#!/bin/bash
#SBATCH --job-name=cafe_t18b
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%A_%a.out
#
# Table 18(b): alternative stratifiers (degree, local clustering, bin size) and
# the coreness gradient within degree bands (CPU).  Reads the stratified
# recommendations of an upstream campaign (UPSTREAM; the paper used the TODO3
# campaign in results_egfix/20260724_degree_eg_sum_in_v1/todo3).
#
#   sbatch reproduce/jobs/t18_structural_controls.job
#   sbatch --export=ALL,STAGE=build reproduce/jobs/t18_structural_controls.job
JOB_NAME=t18_structural_controls
source "${CAFE_REPO:-${SLURM_SUBMIT_DIR:-$PWD}}/reproduce/jobs/_env.sh"
UPSTREAM=${UPSTREAM:-${REPO}/results_egfix/20260724_degree_eg_sum_in_v1/todo3}
CAMPAIGN=${OUT}/results_rq1_controls/structural_controls_v1

if [[ "${STAGE}" == "build" ]]; then
    run_py analysis/rq1_structural_controls.py finalize --campaign-dir "${CAMPAIGN}" --if-complete
    build_and_verify T18
    exit 0
fi
run_py analysis/rq1_structural_controls.py run --dataset "${DS}" --data-path "${DATA}" \
    --upstream-root "${UPSTREAM}" --output-dir "${CAMPAIGN}/shards/${DS}" --threads "${SLURM_CPUS_PER_TASK:-8}"
